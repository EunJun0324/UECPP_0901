# Visual Studio 2015 user specific files
UECPP/.vs/

# Compiled Object files
UECPP/*.slo
UECPP/*.lo
UECPP/*.o
UECPP/*.obj

# Precompiled Headers
UECPP/*.gch
UECPP/*.pch

# Compiled Dynamic libraries
UECPP/*.so
UECPP/*.dylib
UECPP/*.dll

# Fortran module files
UECPP/*.mod

# Compiled Static libraries
UECPP/*.lai
UECPP/*.la
UECPP/*.a
UECPP/*.lib

# Executables
UECPP/*.exe
UECPP/*.out
UECPP/*.app
UECPP/*.ipa

# These project files can be generated by the engine
UECPP/*.xcodeproj
UECPP/*.xcworkspace
UECPP/*.sln
UECPP/*.suo
UECPP/*.opensdf
UECPP/*.sdf
UECPP/*.VC.db
UECPP/*.VC.opendb
UECPP/.vsconfig

# Precompiled Assets
UECPP/SourceArt/**/*.png
UECPP/SourceArt/**/*.tga

# Binary Files
UECPP/Binaries/*
UECPP/Plugins/**/Binaries/*

# Builds
UECPP/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
UECPP/Saved/*

# Compiled source files for the engine to use
UECPP/Intermediate/*
UECPP/Plugins/**/Intermediate/*

# Cache files for the editor to use
UECPP/DerivedDataCache/*
